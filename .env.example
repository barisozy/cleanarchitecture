# Local development environment reference.
#
# The `local` Spring profile imports this file as a properties file when it is named `.env`:
#   copy .env.example .env
# A value in the process environment still wins over the file. The import is optional, so a
# checkout without `.env` starts with the defaults below.
#
# This file is not a deployment mechanism. A container or a CI pipeline should receive the
# variables from its own environment or secret store. Never commit the real `.env` file; it is
# already ignored by Git.

# --- Database -----------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/cleanarchitecture
DB_USERNAME=app
DB_PASSWORD=app

# --- JWT ----------------------------------------------------------------------
JWT_ISSUER=https://api.example.com
JWT_AUDIENCE=cleanarchitecture-api
# Lifetime of the access token. The template has no refresh token, so a client has to log in
# again when the token expires.
JWT_ACCESS_TOKEN_TTL=PT1H
# Base64 encoded secret of at least 32 bytes. Generate one with:
#   openssl rand -base64 32
# The `local` profile ignores it and uses an ephemeral secret instead.
JWT_SECRET=

# --- Web / security -----------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
PROBLEM_BASE_URI=https://api.example.com/problems
# The externally reachable base URL; it is published in the OpenAPI document.
PUBLIC_BASE_URL=http://localhost:8080
# BCrypt cost factor of newly hashed passwords. Existing hashes keep their own cost.
BCRYPT_STRENGTH=10

# --- Docker Compose -----------------------------------------------------------
DOCKER_COMPOSE_ENABLED=true
